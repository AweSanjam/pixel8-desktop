# pixel8-desktop: headless bring-up (USB debugging + DisplayPort out + desktop mode)
on post-fs-data
    mkdir /data/misc/adb 02750 system shell
    copy /system_ext/etc/adb_keys /data/misc/adb/adb_keys
    chown system shell /data/misc/adb/adb_keys
    chmod 0640 /data/misc/adb/adb_keys
    restorecon /data/misc/adb/adb_keys
on boot
    setprop persist.sys.usb.config mtp,adb
    setprop persist.vendor.usb.displayport.enabled 1
on property:sys.boot_completed=1
    setprop persist.vendor.usb.displayport.enabled 1
    setprop persist.sys.usb.config mtp,adb
    setprop sys.usb.config mtp,adb
    start pixel8desktop

service pixel8desktop /system/bin/sh /system_ext/etc/pixel8-desktop.sh
    class late_start
    user root
    group root shell
    seclabel u:r:su:s0
    oneshot
    disabled
